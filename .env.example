# Copy to `.env` and fill in.  `.env` is gitignored — never commit it.
# This repository is public.

# --- Gemini (required for everything) -------------------------------------
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live API model. Defaults to gemini-3.1-flash-live-preview if unset.
# Known-good alternatives if that ID is rotated or unavailable on your key:
#   gemini-2.5-flash-native-audio-preview-12-2025
# Check https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Text model for the WhatsApp channel. Defaults to gemini-3.7-flash (stable).
GEMINI_TEXT_MODEL=gemini-3.7-flash

# --- Twilio (required only for real phone calls, not the isolated test) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164 format, e.g. +15551234567
TWILIO_PHONE_NUMBER=

# WhatsApp sender. Defaults to Twilio's shared Sandbox number if unset.
# A bare +E164 number is accepted and normalised to the whatsapp: form.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# WhatsApp webhook: in the Twilio Console, set Messaging -> Try it out ->
# Send a WhatsApp message -> Sandbox settings -> "When a message comes in" to
#   {BASE_URL}/whatsapp/incoming     (method: POST)
# Users join by texting "join <your sandbox code>" to the sandbox number, which
# also opens the 24-hour free-form messaging window.

# --- Telnyx (alternative voice provider) --------------------------------
# Twilio gates Media Streams behind a paid account, so Telnyx is the fallback
# for real phone calls. Sign up at telnyx.com (free credit, no card).
#   1. Account -> API Keys -> create one (starts KEY...)
#   2. Voice -> Programmable Voice -> Applications -> create a Voice API
#      application, webhook URL {BASE_URL}/telnyx/webhook -> copy Connection ID
#   3. Numbers -> buy a Voice-capable number, assign it to that application
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=

# Public HTTPS URL of this server, no trailing slash, e.g. https://abc123.ngrok-free.app
# ngrok's free tier issues a NEW URL every restart — update this each time,
# or Twilio will call a dead endpoint and the call will fail silently.
BASE_URL=
