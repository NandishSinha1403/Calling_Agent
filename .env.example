# Copy to `.env` and fill in.  Use `cp`, NOT `mv` -- this file is the tracked
# template and you want both to exist.
#
# `.env` is gitignored and must never be committed. This repository is PUBLIC.
#
# Config is validated in GROUPS, so you only need the keys for what you are
# actually running:
#   require_gemini()    -> the isolated test and both channels
#   require_twilio()    -> Twilio voice calls
#   require_telnyx()    -> Telnyx voice calls
#   require_whatsapp()  -> the WhatsApp channel
# A missing key in one group never blocks another.


# ===========================================================================
# GEMINI  (required for everything)
# ===========================================================================

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live API model for the VOICE channel: native speech-to-speech.
# Fallback if this ID is rotated or unavailable on your key:
#   gemini-2.5-flash-native-audio-preview-12-2025
# Check https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Text model for the WHATSAPP channel. A stable release on purpose -- nothing
# here needs a preview-only feature, so there is no reason to accept churn.
GEMINI_TEXT_MODEL=gemini-3.7-flash


# ===========================================================================
# TELNYX  (voice provider -- the one that works on a free account)
# ===========================================================================
# Twilio gates Media Streams behind a PAID account. That was measured, not
# assumed: pointing <Connect><Stream> at a public WebSocket service failed too,
# which ruled out our endpoint and the tunnel. See PR #21.
#
# Telnyx uses the same connected/start/media/stop events, the same media
# payload shape, the same `clear` event for barge-in, and PCMU -- which is
# mu-law at 8kHz, exactly what audio_utils already produces.
#
# Setup:
#   1. Sign up at telnyx.com (free credit, no card)
#   2. Voice -> Programmable Voice -> Applications -> create a Voice API
#      application. Webhook URL: {BASE_URL}/telnyx/webhook, API v2.
#      The Connection ID is in the URL of the application page.
#   3. Numbers -> Buy a Voice-capable number (free on pre-trial credits),
#      then ASSIGN it to that application -- an unassigned number will not
#      route, and the number list warns "Required for calls" until you do.
#   4. Verified Numbers -> add the number you intend to call. Trials restrict
#      outbound to verified destinations.
#   5. Account -> API Keys -> create one (starts KEY...)

TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
# Your Telnyx number, E.164, e.g. +19804946870
TELNYX_PHONE_NUMBER=


# ===========================================================================
# TWILIO  (voice calls need a PAID account; WhatsApp Sandbox works on trial)
# ===========================================================================
# Console home -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Voice only. Console -> Communications -> Numbers & senders -> Manage ->
# Active numbers. Also add your mobile under Verified Caller IDs: trial
# accounts can only call verified numbers.
TWILIO_PHONE_NUMBER=

# WhatsApp sender. Defaults to Twilio's shared Sandbox number if unset.
# A bare +E164 is accepted and normalised to the whatsapp: form.
#
# Sandbox setup: Console -> Messaging -> Try it out -> Send a WhatsApp message
#   -> Sandbox settings -> "When a message comes in":
#        {BASE_URL}/whatsapp/incoming     (POST)
# Users join by texting "join <your sandbox code>" to the sandbox number, which
# also opens the 24-hour free-form messaging window.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# ===========================================================================
# SERVER
# ===========================================================================

# Public HTTPS URL of this server, no trailing slash.
#   ngrok http 8000
# ngrok's free tier issues a NEW URL on every restart. A stale value here is
# the single most common breakage on this project -- both channels' webhooks
# point at it. `curl localhost:8000/health` shows what the server currently
# believes, which is the fastest way to catch it.
BASE_URL=

# Diagnostic. ECHO_MODE=1 makes the voice WebSocket echo the caller's own audio
# back instead of bridging to Gemini. When a call goes silent, this answers
# "Twilio/Telnyx side, or Gemini side?" in one restart.
# ECHO_MODE=
